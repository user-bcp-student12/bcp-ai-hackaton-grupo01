# Copy to .env (gitignored) and fill in. Add every new env var here, with a comment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Relative to the repository root; database data remains gitignored.
DATABASE_PATH=.orchestrate/wallet-demo.sqlite
WEB_ORIGIN=http://localhost:5173
# This application only supports fictitious local funds and identity checks.
DEMO_MODE=true
DEMO_KYC_RESULT=activa
DEMO_INITIAL_BALANCE_CENTS=100000
PAYMENT_MAX_CENTS=50000
SESSION_TTL_SECONDS=3600
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Public frontend setting, never a secret.
VITE_API_BASE_URL=/api/v1
